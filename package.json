{
  "name": "student-evaluation-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "deploy:production": "powershell -ExecutionPolicy Bypass -File scripts/deploy-production-vercel.ps1",
    "deploy:test": "powershell -ExecutionPolicy Bypass -File scripts/deploy-test-vercel.ps1",
    "start": "next start",
    "test": "vitest run && npm run test:guards",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:guards": "node --test scripts/clear-test-year.test.cjs scripts/repair-import-values.test.cjs scripts/migrate-test-google-sso.test.cjs scripts/stage-test-google-sso-resources.test.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "ag-grid-community": "latest",
    "ag-grid-react": "latest",
    "fflate": "0.8.3",
    "firebase": "latest",
    "next": "latest",
    "pdfjs-dist": "6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "xlsx": "latest",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
